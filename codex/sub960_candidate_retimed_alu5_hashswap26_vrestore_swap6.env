# Equal-resource cross-engine retiming.  In each critical round-8 group, move
# hash_1_const from VALU to eight scalar ALU lanes and move the later layout
# restore from eight scalar ALU lanes to VALU.  Counts stay identical to the
# proven individually-feasible hash-swap DAG, but the relocated-address chain
# remains on VALU through the restore instead of crossing into early ALU time.
source codex/sub960_candidate_retimed_alu5_hashswap26.env

export VECTOR_RESTORE_LAYOUT_SET='1,15,21,23,26,27'
# Five very wide-window early hash constants plus group 26's round-8 constant
# pay for the six vector restores.  The other five critical groups already
# use scalar hash_1_const in the parent DAG, so repeating them would not free
# a VALU slot.
export HASH_SCALAR_EXTRA_ADD_AFTER='6:8,21:0,23:0,17:1,20:2,22:1,18:0'
