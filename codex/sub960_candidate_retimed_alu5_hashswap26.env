# Same 959-cycle resource budget as sub960_candidate_retimed_alu5, but move
# one scalar hash-constant XOR from group 26 to group 6 in round 8.  This
# preserves ALU/VALU counts exactly while improving the observed joint
# ALU+VALU list schedule from 1020 to 1014 (seed 890 in the extended search).
source codex/sub960_candidate_retimed_alu5.env

export HASH_SCALAR_EXTRA_REMOVE_AFTER='26:8'
export HASH_SCALAR_EXTRA_ADD_AFTER='6:8'
