# Resource-balanced 959-cycle semantic candidate.
#
# Start from the p6 structural graph, but lower the two final level-4
# VALU-difference/MADD pairs back to a single Flow vselect.  Two fewer output
# pointer pairs use Flow so the trade is net-neutral on the unary engine while
# leaving four additional VALU slots and four Flow bubbles for global
# cross-engine retiming.
source codex/sub960_candidate_retimed_alu5_hashswap26_vrestore1.env

export FLOW_OUTPUT_ADVANCE_POSITIONS='5,6,7,8'
export LOAD_IMMEDIATE_TAGS='top_pointer,tree_original_layout_reflect,input_pointer'
export ALU_DERIVED_MISC_SET='m4,m23'
export VALU_FINAL_CACHE_COUNTS='5:0,11:0'
export TARGET=959
