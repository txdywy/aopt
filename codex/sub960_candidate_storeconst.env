# Strict-Hall-slack 959-cycle candidate with minimal engine transfers.
#
# Move raw_root_copy from ALU to an otherwise free Flow slot.  Materialize the
# setup-only v_hash_c4 through the idle Store engine and one staged vector
# Load, removing its VALU broadcast.  At horizon 959 the bare DAG has Hall
# overload -1 ALU, -1 VALU, -2 Load, -2 Store, and -1 Flow.
source codex/sub960_candidate_alu1f945.env

export ALU_RAW_ROOT_COPY=0
export MEMORY_VECTOR_CONSTANT_SET='v_hash_c4'
