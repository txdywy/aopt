# Retiming experiment derived from the strongest hash-swap DAG.  The six
# groups responsible for every remaining max-38 ALU/VALU projected edge use a
# single vector subtraction for the round-8 layout restore instead of eight
# scalar ALU instructions.  Net resource delta: ALU -48, VALU +6.
source codex/sub960_candidate_retimed_alu5_hashswap26.env

export VECTOR_RESTORE_LAYOUT_SET='1,15,21,23,26,27'
