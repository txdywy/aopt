# Zero-cost strict-Hall-slack 959-cycle candidate.
#
# Scalar constant 11 (hash C4 in construction order) is already emitted by
# Flow.  Use its own architecturally-zero scratch word as the add_imm base so
# it is ready in cycle 0 and its VALU broadcast can execute in cycle 1, outside
# the otherwise saturated [2, 956] VALU window.  Materialize scalar one and
# scalar eight with the two Load slots in cycle 0, leaving C4 alone on Flow.
# Move raw_root_copy from ALU to Flow.  Net effect: two early Loads replace two
# Flow ops, raw_root consumes one Flow slot, and every engine has strict Hall
# slack while the Flow count falls from 945 to 944.
source codex/sub960_candidate_alu1f945.env

export ALU_RAW_ROOT_COPY=0
export FLOW_ONE_CONSTANT=0
export FLOW_SCALAR_CONSTANT_SET='1,2,4,6,7,8,10,11,12,14'
export FLOW_ZERO_BASE_CONSTANT_SET='1,2,4,11'
