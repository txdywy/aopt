# 959-cycle Hall-feasible research graph.
#
# This is deliberately opt-in: it has passed the exact earliest/latest Hall
# necessary tests for every physical engine, but still needs a strict full-DAG
# schedule before it can replace the embedded 987-cycle submission.
source codex/sub959_candidate_hallfeasible_direct22.env

# Move two level-4 gathers out of the VALU-heavy hybrid mux.  The paired final
# lookup keeps the FLOW calendar within its unit-capacity Hall bound.
export GATHER_LEVEL4='1:4,10:4,3:4,8:4'
export PAIRED_DIRECT_BRANCH_LOOKUPS='26:4'
export HASH_SCALAR_EXTRA_COUNT=164
export LOAD_IMMEDIATE_TAGS='scalar_constant'

# Deliberately leave only the late cache suffix in memory.  The resulting
# seven fewer cache loads and one memory-backed vector constant exactly balance
# the VALU/LOAD Hall windows at H=959.
export MEMORY_CACHED_NODE_SET='16,17,18,19,20,22,23,24,25,26,27,28,29'
export MEMORY_VECTOR_CONSTANT_SET='v_hash_c1'
export MEMORY_VECTOR_CONSTANT_ORDER='v_hash_c1'
export TARGET=959
