# Combined 959-cycle Pareto candidate.
#
# sub960_candidate_alu5 has a proven Flow->Load Hall-0 order.  Apply the
# setup retiming from sub960_candidate_retimed to remove the ALU/VALU zero-Hall
# bottlenecks without disturbing the steady-state selector/gather structure.
source codex/sub960_candidate_alu5.env

export ALU_RAW_ROOT_COPY=0
export FLOW_ONE_CONSTANT=0
export FLOW_SCALAR_CONSTANT_SET='1,2,4,6,7,8,10,11,12,14'
export FLOW_ZERO_BASE_CONSTANT_SET='1,2,4,11'
