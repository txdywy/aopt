# H959 research candidate: remove the minimal ALU<->FLOW phase cut in group 0.
#
# The eight early group-0 mirror parity extractions are vectorized.  This
# removes the repeated mirror_bit(ALU)->tree_select(FLOW) edges.  The hash
# scalar count and hybrid bottom counts keep the aggregate ALU/VALU/FLOW/LOAD
# Hall bounds non-positive at H=959.  It remains a research graph: the exact
# full-DAG solver still finds a separate FLOW critical-chain conflict, so this
# must not replace the production 987-cycle schedule without a legal schedule.
source codex/sub959_candidate_hallfeasible_g5pair.env

export VECTOR_PARITY_SET='31:11,31:12,31:13,31:14,16:14,21:13,21:14,0:0,0:1,0:2,0:3,0:11,0:12,0:13,0:14'
export HYBRID_MADD_OVERRIDES='1:4:0,3:4:0,4:4:0,5:4:0,6:4:7,7:4:0,9:4:8,10:4:8'
export HASH_SCALAR_EXTRA_COUNT=165
export TARGET=959
