# Equal-resource critical-path retiming derived from the max-36 vrestore1
# schedule.  Scalarize g17:r9's hash shift (VALU -> eight ALU lanes) and spend
# the released vector slot on g17:r8's layout restore (eight ALU lanes ->
# VALU).  Engine counts are unchanged, while both observed VALU->ALU peak
# crossings become same-engine chains without requiring a new vector constant.
source codex/sub960_candidate_retimed_alu5_hashswap26_vrestore1.env

export VECTOR_RESTORE_LAYOUT_SET='1,17'
export SCALAR_HASH1_SHIFT_SET='17:9'
