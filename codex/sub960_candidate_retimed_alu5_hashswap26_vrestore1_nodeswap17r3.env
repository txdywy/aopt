# Equal-resource two-sided fusion selected from the max-36 peak-edge census.
# g17:r3 contributes eight node_xor -> hash_0 edges and seven
# hash_1_const -> hash_1_join edges at the peak.  Vectorizing node_xor and
# scalarizing hash_1_join makes both chains intra-engine while preserving the
# exact ALU/VALU instruction counts (eight ALU <-> one VALU in each direction).
source codex/sub960_candidate_retimed_alu5_hashswap26_vrestore1.env

export VECTOR_NODE_XOR_SET='17:3'
export SCALAR_HASH1_JOIN='18:15,17:3'
